# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/

# Modelos OCR descargados on-demand (~15 MB)
vision/models/*.onnx
vision/models/*.pt
vision/models/*.pth
# Excepcion: nuestros modelos custom entrenados SI se versionan (artefactos del proyecto).
!vision/models/angle_number.onnx
!vision/models/wind_pointer.onnx
!vision/models/wind_number.onnx
!vision/models/wind_number.onnx

# --- Node / Svelte / Vite ---
node_modules/
/build
/.svelte-kit
/package
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- Rust / Tauri ---
src-tauri/target/
# Cargo.lock SÍ se commitea — somos una app, no lib (reproducibilidad)
# (no excluir Cargo.lock)

# --- Logs y debug runtime ---
tauri-dev.log
tauri-dev.log.err
*.log.err

# --- Dataset de entrenamiento ---
# Capturas REALES del juego (raw/angle): SI se versionan — no son
# reproducibles (hay que capturarlas a mano del HUD). Pesan poco (~4.5 MB).
# Los labels JSON tambien se versionan (documentan el dataset, livianos).
#
# Datasets SINTETICOS del viento (raw/wind_number, raw/wind_pointer): NO se
# versionan — pesan 2.7 GB y son REGENERABLES con el visor `almeyda-wind-visor`
# (mismo proceso, los labels JSON quedan versionados como referencia). Meterlos
# en git inflaria el repo sin sentido (PNG no se diffean, se regeneran).
assets/dataset/raw/wind_number/
assets/dataset/raw/wind_pointer/
# Outputs temporales de debug.
assets/dataset/_debug_seg/
assets/dataset/_debug/

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# --- Backups (mientras setup) ---
*.backup
*.backup.md
