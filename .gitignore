# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
*.egg-info/

# Modelos OCR descargados on-demand (~15 MB)
vision/models/*.onnx
vision/models/*.pt
vision/models/*.pth
# Excepcion: nuestro modelo custom entrenado SI se versiona (612 KB, artefacto del proyecto).
!vision/models/digit_classifier.onnx

# --- Node / Svelte / Vite ---
node_modules/
/build
/.svelte-kit
/package
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# --- Rust / Tauri ---
src-tauri/target/
# Cargo.lock SÍ se commitea — somos una app, no lib (reproducibilidad)
# (no excluir Cargo.lock)

# --- Logs y debug runtime ---
tauri-dev.log
tauri-dev.log.err
*.log.err

# --- Dataset de entrenamiento ---
# Las imagenes SI se versionan: son el corazon del proyecto (sin ellas el
# modelo no es reproducible ni se puede re-entrenar/mejorar). Son numeros de
# un HUD de juego, nada sensible, y pesan poco (<1 MB el dataset, ~18 MB con
# las samples full). Solo excluimos outputs temporales de debug.
assets/samples/_debug/
assets/dataset/_debug_seg/
assets/dataset/_debug/

# --- IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# --- Backups (mientras setup) ---
*.backup
*.backup.md
